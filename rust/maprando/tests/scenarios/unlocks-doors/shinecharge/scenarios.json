{
  "$schema": "../../../schema/scenarios.schema.json",
  "scenarios": [
    {
      "name": "Reaching DoorUnlock Vertex Retains Remaining Shinecharge",
      "lockedDoors": [{"roomId": 0, "nodeId": 3, "type": "red"}],
      "globalState": {"maxSupers": 1},
      "startRoomId": 0,
      "startNodeId": 1,
      "startState": {"supers": {"remaining": 1}, "shinechargeFramesRemaining": 100},
      "endRoomId": 0,
      "endNodeId": 2,
      "endDoorUnlockNodeId": 3,
      "endState": {"shinechargeFramesRemaining": 15}
    },
    {
      "name": "Returning from DoorUnlock Preserves Shinecharge Without More Ammo",
      "lockedDoors": [{"roomId": 0, "nodeId": 3, "type": "red"}],
      "startRoomId": 0,
      "startNodeId": 2,
      "startDoorUnlockNodeId": 3,
      "startState": {"shinechargeFramesRemaining": 15},
      "endRoomId": 0,
      "endNodeId": 2,
      "endState": {"shinechargeFramesRemaining": 15}
    },
    {
      "name": "Use Shinecharge After DoorUnlock",
      "lockedDoors": [{"roomId": 0, "nodeId": 3, "type": "red"}],
      "startRoomId": 0,
      "startNodeId": 2,
      "startDoorUnlockNodeId": 3,
      "startState": {"shinechargeFramesRemaining": 15},
      "endRoomId": 0,
      "endNodeId": 4
    },
    {
      "name": "Fail: Not Enough Shinecharge After DoorUnlock",
      "lockedDoors": [{"roomId": 0, "nodeId": 3, "type": "red"}],
      "startRoomId": 0,
      "startNodeId": 2,
      "startDoorUnlockNodeId": 3,
      "startState": {"shinechargeFramesRemaining": 14},
      "endRoomId": 0,
      "endNodeId": 4,
      "fail": true
    }
  ]
}
